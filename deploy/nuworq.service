# /etc/systemd/system/nuworq.service
#   sudo useradd --system --home /var/lib/nuworq --shell /usr/sbin/nologin nuworq
#   sudo git clone <repo> /opt/nuworq   (or copy the folder there)
#   sudo -u nuworq node /opt/nuworq/bin/nuworq.js token create <you> --role human --db /var/lib/nuworq/nuworq.db
#   sudo systemctl enable --now nuworq
[Unit]
Description=nuworq hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuworq
Group=nuworq
WorkingDirectory=/opt/nuworq
# Loopback + --auth behind Caddy or `tailscale serve`. For LAN-only without a proxy,
# use --host 0.0.0.0 instead (login is then required automatically) and drop --trust-proxy.
ExecStart=/usr/bin/node /opt/nuworq/bin/nuworq.js serve --host 127.0.0.1 --port 4747 --db /var/lib/nuworq/nuworq.db --auth --trust-proxy
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
StateDirectory=nuworq
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nuworq
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
# Not set: MemoryDenyWriteExecute (Node's JIT needs writable+executable memory).

[Install]
WantedBy=multi-user.target
