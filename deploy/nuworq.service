# /etc/systemd/system/nuworq.service
#   sudo useradd --system --create-home --home-dir /var/lib/nuworq --shell /usr/sbin/nologin nuworq
#   sudo install -d -o nuworq -g nuworq /opt/nuworq && sudo -u nuworq git clone <repo> /opt/nuworq
#   sudo -u nuworq node /opt/nuworq/bin/nuworq.js token create <you> --role human --db /var/lib/nuworq/nuworq.db
#   sudo systemctl enable --now nuworq
# --follow keeps the hub on the latest main in /opt/nuworq that passes its tests (it runs from
# /var/lib/nuworq/hub-src and tests new commits in hub-next). Verified on Debian 13 in a Proxmox LXC.
[Unit]
Description=nuworq hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuworq
Group=nuworq
WorkingDirectory=/opt/nuworq
# Loopback + --auth behind Caddy or `tailscale serve`. For LAN-only without a proxy,
# use --host 0.0.0.0 instead (login is then required automatically) and drop --trust-proxy.
ExecStart=/usr/local/bin/node /opt/nuworq/bin/nuworq.js serve --follow --host 127.0.0.1 --port 4747 --db /var/lib/nuworq/nuworq.db --auth --trust-proxy
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production HOME=/var/lib/nuworq NUWORQ_DATA_DIR=/var/lib/nuworq
StateDirectory=nuworq
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# /opt/nuworq: --follow adds its worktrees to the repo there.
ReadWritePaths=/var/lib/nuworq /opt/nuworq
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
# Not set: MemoryDenyWriteExecute (Node's JIT needs writable+executable memory).

[Install]
WantedBy=multi-user.target
